# Copia este archivo como .env (NO se sube a GitHub) y completa los valores.
# Si falta alguno, el dashboard local funciona igual pero sin enviar datos a la nube.

# Realtime Database > URL (termina en firebasedatabase.app o firebaseio.com)
FIREBASE_DB_URL=https://data-base-em-default-rtdb.firebaseio.com
# Configuración del proyecto > General > Clave de API web (es pública; la seguridad la dan las reglas)
FIREBASE_API_KEY=
# Usuario creado en Authentication > Users (método Correo/contraseña). Solo este usuario puede escribir.
FIREBASE_EMAIL=
FIREBASE_PASSWORD=
# Opcionales
FIREBASE_ROOT=estacion
FIREBASE_LIVE_SECONDS=3
